# ARK Vault - Environment Variables

# Telegram Bot Token (from @BotFather). Also verifies Telegram Login Widget
# signatures for the web app, so it must stay server-side only.
TELEGRAM_BOT_TOKEN=

# --- Storage (required) ---
# Postgres is the single system of record: journals, gamification, sessions and
# the Telegram delivery ledger. It replaces Notion and BadgerDB.
DATABASE_URL=postgres://arkvault:change-me@postgres:5432/arkvault?sslmode=disable

# Local volume root for trade screenshots.
IMAGE_DIR=/data/images

# --- Web app ---
# Signing material for web sessions. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Public origin the web app is served from, e.g. https://vault.example.com
PUBLIC_BASE_URL=

# API listen address (empty or "off" disables the web app).
API_ADDR=:8080

# --- Discord OAuth (optional: leave empty to disable Discord login) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must match the redirect registered in the Discord developer portal exactly.
DISCORD_REDIRECT_URL=https://vault.example.com/api/auth/discord/callback

# Log level: debug, info, warn, error
LOG_LEVEL=info

# --- Weekly Report Auto-Post ---
# Group chat ID to post weekly reports to (get via @userinfobot or bot API)
# Leave empty to disable auto-post
REPORT_CHAT_ID=

# Topic/Thread ID for groups with Topics (Forum) enabled
# Get from the URL: web.telegram.org/a/#-100xxxx_69 → the number after underscore
# Leave empty or 0 to post to General / main chat
REPORT_THREAD_ID=

# Day of week to post report: sunday, monday, tuesday, etc.
REPORT_DAY=sunday

# Hour (0-23 WIB) to post the report
REPORT_HOUR=20

# --- Rate Limiting ---
# Max commands per user per minute (default: 10)
RATE_LIMIT_PER_MIN=10

# --- Community Membership Gate ---
# Telegram group ID that users must be a member of to use the bot
# Leave empty to allow everyone (no gate)
COMMUNITY_GROUP_ID=

# Owner's Telegram user ID (for "contact owner" link in membership gate)
# Get via @userinfobot
OWNER_ID=

# --- Gemini AI (Analytics & Report Card) ---
# Google Gemini API key (from https://aistudio.google.com/apikey)
# Leave empty to disable AI features (/analyze, /reportcard AI summary)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-preview

# --- Metrics ---
# Prometheus/health listener. Keep bound to loopback in compose.
METRICS_ADDR=:9102
